@model IEnumerable<TechFixOS.Models.Entidades.OrdemServico>

@{
    ViewData["Title"] = "Ordens de Serviço";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Ordens de Serviço</h2>
        <a asp-action="Create" class="btn btn-primary">
            Nova OS
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Cliente</th>
                    <th>Técnico</th>
                    <th>Serviço</th>
                    <th>Data Abertura</th>
                    <th>Status</th>
                    <th>Valor Total</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Cliente?.Nome</td>
                        <td>@item.Tecnico?.Nome</td>
                        <td>@item.Servico?.Nome</td>
                        <td>@item.DataAbertura.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.Status == "Concluída")
                            {
                                <span class="badge bg-success">@item.Status</span>
                            }
                            else if (item.Status == "Em Andamento")
                            {
                                <span class="badge bg-primary">@item.Status</span>
                            }
                            else if (item.Status == "Cancelada")
                            {
                                <span class="badge bg-danger">@item.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@item.Status</span>
                            }
                        </td>
                        <td>@item.ValorTotal.ToString("C")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                Editar
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Deseja realmente excluir esta OS?');">
                                <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">
            Nenhuma ordem de serviço cadastrada. Clique em "Nova OS" para começar.
        </div>
    }
</div>
