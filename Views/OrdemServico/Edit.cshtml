@model TechFixOS.Models.Entidades.OrdemServico

@{
    ViewData["Title"] = "Editar Ordem de Serviço";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Editar Ordem de Serviço #@Model.Id</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="DataAbertura" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label class="form-label">Data de Abertura</label>
                            <input class="form-control" value="@Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")" disabled />
                        </div>

                        <div class="mb-3">
                            <label asp-for="ClienteId" class="form-label"></label>
                            <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.ClienteId">
                                <option value="">-- Selecione um cliente --</option>
                            </select>
                            <span asp-validation-for="ClienteId" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TecnicoId" class="form-label"></label>
                                <select asp-for="TecnicoId" class="form-select" asp-items="ViewBag.TecnicoId">
                                    <option value="">-- Selecione um técnico --</option>
                                </select>
                                <span asp-validation-for="TecnicoId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServicoId" class="form-label"></label>
                                <select asp-for="ServicoId" class="form-select" asp-items="ViewBag.ServicoId">
                                    <option value="">-- Selecione um serviço --</option>
                                </select>
                                <span asp-validation-for="ServicoId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label"></label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Pendente">Pendente</option>
                                    <option value="Em Andamento">Em Andamento</option>
                                    <option value="Concluída">Concluída</option>
                                    <option value="Cancelada">Cancelada</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ValorTotal" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <input asp-for="ValorTotal" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="ValorTotal" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                            <button type="submit" class="btn btn-warning">Atualizar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
